# Server
# ----------------------------------------------------------------------
# Porta da API
PORT=3000

# URL exposta da API (usada pelo frontend em produção)
API_PUBLIC_URL=http://localhost:3000

# CORS: origem permitida do frontend (impede acesso arbitrário)
CORS_ORIGIN=http://localhost:5173

# Limites de uso
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Timeout de processamento de uma URL (ms)
PROCESS_TIMEOUT_MS=60000

# Timeout de download de um arquivo (ms)
DOWNLOAD_TIMEOUT_MS=900000

# Quantidade máxima de downloads/processamentos simultâneos
MAX_CONCURRENT=2

# Tamanho máximo aceito para respostas (bytes)
MAX_RESPONSE_BYTES=524288000

# Diretórios de trabalho
TEMP_DIR=temp
DOWNLOAD_DIR=downloads
LOG_DIR=logs

# Tempo de vida dos arquivos temporários (ms)
TEMP_FILE_TTL_MS=3600000

# Caminho do binário do yt-dlp (deixe vazio para usar o da PATH)
YT_DLP_PATH=

# Serve o frontend estático construído no mesmo processo (deploy de peça única).
# Deixe vazio para API apenas (frontend separado, ex.: Netlify).
# FRONTEND_DIST=frontend/dist

# Segurança SSRF: seguir redirects e validar o destino final
SSRF_FOLLOW_REDIRECTS=true
SSRF_REDIRECT_TIMEOUT_MS=8000

# Analytics / Ads (preenchidos posteriormente pelo proprietário)
# IDs vazios = recursos desativados; o frontend só carrega scripts com ID real
# E com o consentimento correspondente do usuário (análise/publicidade).
GA4_ID=
ADSENSE_ID=
ANALYTICS_ID=

# Frontend "build"
# ----------------------------------------------------------------------
# URL da API usada pelo frontend.
# Vazio (recomendado no deploy de peça única) = mesmo domínio.
# Em dev, mantenha http://localhost:3000.
VITE_API_URL=http://localhost:3000